#!/bin/zsh

prev_ref="$1"
new_ref="$2"
checkout_type="$3" # 1 = branch, 0 = file checkout
excluded=(master main dev staging prod)

if (( checkout_type == 1 )); then
  new_branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

  if ! (( ${excluded[(Ie)$new_branch]} )); then
    echo "Branch changed to: $new_branch. Adding to worklog"
    worklog new --git
  fi 
fi

