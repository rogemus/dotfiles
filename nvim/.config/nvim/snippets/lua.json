{
  "local": {
    "prefix": "ls",
    "body": [
      "local ${1:functionName} = function (${2})",
      "  ${0}",
      "end"
    ]
  },
  "fun": {
    "prefix": "fun",
    "body": [
      "function ${1:fname}(${2:...})",
      "  $0",
      "end"
    ]
  },
  "var": {
    "prefix": "var",
    "body": "local ${1:varName} = ${2:\"value\"}"
  }
}
