{
  "export * from ...": {
    "prefix": "ex",
    "body": "export * from \"./${1:filename}\";"
  },
  "export default from ...": {
    "prefix": "exd",
    "body": "export { default } from \"./${1:filename}\";"
  },
  "component type": {
    "prefix": "ctype",
    "body": [
      "export type ${1:typeName}Props = {",
      "};"
    ]
  },
  "testing with vitest": {
    "prefix": "testv",
    "body": [
      "import { expect, test, describe } from 'vitest'",
      "import { ${1} } from \"./${1}\";",
      "",
      "describe(\"@name/${1}\", () => {",
      "  test(\"${1}\", () => {",
      "    ${0}",
      "  });",
      "})"
    ]
  }
}
