# ─── Theme ─────────────────────────────────────────────────────────
theme = Catppuccin Mocha

# ─── Font ──────────────────────────────────────────────────────────
font-family = Fira Code Nerd Font Mono
font-size = 15 

# ─── Window ────────────────────────────────────────────────────────
background = #000000
macos-icon-frame = plastic
# window-decoration = none
window-padding-x = 7
window-padding-y = 5

# ─── Keys (Ctrl-Tab opens the tmux session switcher, Ctrl-1..0 switch nvim tabs) ───
macos-option-as-alt = true
keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~
keybind = ctrl+0=text:\x1b[27;5;48~
