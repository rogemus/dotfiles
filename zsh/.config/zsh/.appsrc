#!/bin/bash

# fzf
eval "$(fzf --zsh)"

# Zoxide
eval "$(zoxide init zsh)"

#compdef just
source <(JUST_COMPLETE=zsh just)
if [ "$funcstack[1]" = "_just" ]; then
  _clap_dynamic_completer_just "$@"
fi

# bun completions
[ -s "/Users/kacper.rogowski/.bun/_bun" ] && source "/Users/kacper.rogowski/.bun/_bun"
