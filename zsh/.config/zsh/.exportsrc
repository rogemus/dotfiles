#!/usr/bin/env zsh

# ─── History ───────────────────────────────────────────────────────
export HISTFILE=$ZDOTDIR/.zsh_history
export HISTSIZE=50000
export SAVEHIST=50000

setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_NO_DUPS
setopt HIST_VERIFY
setopt SHARE_HISTORY

# ─── Shell behaviour ───────────────────────────────────────────────
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# ─── Directory navigation ──────────────────────────────────────────
setopt AUTO_CD

# ─── History substring search highlight ────────────────────────────
export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=#a6e3a1,fg=#11111b,bold'
export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=#f38ba8,fg=#11111b,bold'

# ─── Editor ────────────────────────────────────────────────────────
export EDITOR=nvim

# ─── Locale ────────────────────────────────────────────────────────
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8

# ─── Node (nvm) ────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
# Put the newest installed Node on PATH without loading nvm (nvm.sh is loaded lazily, see modules/node.zsh)
() {
  setopt local_options numeric_glob_sort
  local -a versions=($NVM_DIR/versions/node/v*(N/On))
  (( $#versions )) && export PATH="${versions[1]}/bin:$PATH"
}

# ─── Scripts ───────────────────────────────────────────────────────
export FQJ_PATH=/usr/local/bin/fjq.sh

# ─── fzf ───────────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git --exclude node_modules'
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range :200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always --level=2 {}'"
export FZF_DEFAULT_OPTS="
  --height=40% --layout=reverse --border --info=inline
  --color=bg+:#313244,bg:#000000,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

# ─── Go ────────────────────────────────────────────────────────────
export GOPATH=$HOME/go
export GOBIN=$GOPATH/bin
export GOROOT="/opt/homebrew/opt/golang/libexec"

# ─── pnpm ──────────────────────────────────────────────────────────
export PNPM_HOME="$HOME/.local/share/pnpm"

# ─── curl ──────────────────────────────────────────────────────────
export LDFLAGS="-L/opt/homebrew/opt/curl/lib"
export CPPFLAGS="-I/opt/homebrew/opt/curl/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/curl/lib/pkgconfig"
